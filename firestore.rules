rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS collection
    match /users/{userId} {
      // Users can read & update only their own profile
      allow read, update: if request.auth != null && request.auth.uid == userId;

      // Users can create their profile when signing up
      allow create: if request.auth != null && request.auth.uid == userId;

      // Admins can do anything
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // PICKUP REQUESTS
    match /pickup_requests/{requestId} {
      // Users can create their own requests
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid;

      // Users can only see/update their own requests
      allow read, update, delete: if request.auth != null &&
                                  request.auth.uid == resource.data.userId;

      // Admins can see and manage all requests
      allow read, update, delete: if request.auth != null &&
                                  request.auth.token.admin == true;
    }

    // SCRAP PRICES (admin only)
    match /scrap_prices/{docId} {
      allow read: if true; // users can read
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // BANNERS (admin only)
    match /banners/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ANNOUNCEMENTS (admin only to write, public read)
    match /info_posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // AWARENESS POSTS
    match /awareness_posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // VENDORS
    match /vendor_requests/{docId} {
      allow create: if request.auth != null; // users can request
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /vendors/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /vendor_history/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // CERTIFICATES (admin only)
    match /certificates/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // DROP POINTS
    match /dropoffs/{docId} {
      allow read: if true; // everyone can see
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // IMPACT SETTINGS
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
    